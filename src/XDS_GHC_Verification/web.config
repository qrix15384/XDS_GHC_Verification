<?xml version="1.0" encoding="utf-8"?>
<!--
  Customizations merged into the SDK-generated web.config on every `dotnet
  publish` (the <aspNetCore> handler entry is added automatically by the SDK;
  this file only needs to carry what it doesn't already know about).

  WebDAVModule/handler removal: without this, IIS's WebDAV Publishing feature
  (if enabled on the server) intercepts PUT/DELETE before they ever reach the
  ASP.NET Core app, returning 405 Method Not Allowed with
  `Allow: GET, HEAD, OPTIONS, TRACE` — breaking the user-management
  update/delete endpoints even though GET/POST work fine.
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
