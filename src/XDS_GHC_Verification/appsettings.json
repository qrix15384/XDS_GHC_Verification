{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppInfo": {
    "Name": "XDS GHC Verification Service",
    "Version": "1.0.0"
  },
  "ServiceAuth": {
    "ApiKey": "change-me-service-key",
    "AuthUsername": "change-me-username",
    "AuthPassword": "change-me-password"
  },
  "Upstream": {
    "BaseUrl": "https://selfie.imsgh.org:2035/skyface",
    "AuthType": "None",
    "ApiKey": "change-me-upstream-key",
    "ApiKeyHeader": "X-API-Key",
    "BasicUsername": "",
    "BasicPassword": "",
    "TimeoutSeconds": 30.0
  },
  "Selfie": {
    "MerchantKey": "change-me-merchant-key",
    "Center": "BRANCHLESS",
    "UserId": "change-me-user-id"
  },
  "CreditApi": {
    "BaseUrl": "https://www.online.xdsdata.com/XdsDataRestApi",
    "Username": "change-me-credit-api-username",
    "Password": "change-me-credit-api-password",
    "TimeoutSeconds": 30.0
  },
  "Cors": {
    "AllowedOrigins": "*"
  },
  "Jwt": {
    "SigningKey": "change-me-jwt-signing-key-at-least-32-characters-long",
    "Issuer": "XDS_GHC_Verification",
    "Audience": "XDS_GHC_Verification",
    "ExpiryMinutes": 480
  },
  "ConnectionStrings": {
    "Verification": "Server=localhost;Database=XdsGhcVerification;User Id=change-me-db-user;Password=change-me-db-password;Encrypt=True;TrustServerCertificate=True;"
  }
}
